{
  "name": "todolist",
  "version": "1.0.0",
  "description": "An advanced, personal, offline-first task management Progressive Web App built with React, TypeScript, Vite, and Tailwind CSS.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
